{
  "name": "ainovr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:mcp": "vite build --config vite.mcp.config.ts",
    "prepare:desktop-sidecar": "node scripts/prepare-desktop-sidecar.mjs",
    "build:cli": "vite build --config vite.cli.config.ts",
    "mcp": "node dist-mcp/ainovr-mcp.mjs --workspace .",
    "cli": "node dist-cli/ainovr-cli.mjs --workspace .",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run --exclude \"**/real-api/**\"",
    "test:watch": "vitest --exclude \"**/real-api/**\"",
    "test:real": "vitest run src/__tests__/real-api",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "better-sqlite3": "^13.0.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.18.2",
    "vite": "^7.0.4",
    "vitest": "^4.0.0"
  }
}
